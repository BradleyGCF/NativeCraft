{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "jsx": "react",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": false,
    "module": "ESNext",
    "target": "ES6",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "skipLibCheck": false,
    "types": [
      "react-native"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "extends": "expo/tsconfig.base"
}
